{
  "schemaVersion": "2.0.0",
  "info": {
    "title": "Identity Client Add-on (nsswitch, SSSD, Kerberos)",
    "id": {
      "group": null,
      "name": "TA-authid",
      "version": "1.0.0"
    },
    "author": [{"name":"Michael \"JKat54\" Bentley","email":"michael@bentleypc.com","company":"BentleyPC LLC"}],
    "releaseDate": "11/14/2026",
    "description": "Collects identity-client state: name-service lookup order from /etc/nsswitch.conf, SSSD service state and configured domains, system Kerberos ticket cache count, and nscd/oddjob presence where installed. Emits JSON events to index=main (sourcetype authid:status) and authid.* metrics to index=metrics (sourcetype authid:metrics); local-auth-only hosts report the baseline without alarms.",
